<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEasy - E-Commerce</title>
</head>

<body>
    <header>
        <h1>ShopEasy</h1>
        <p>Your Online Shopping Store</p>
        <nav>
            <a href="#featured">Featured Products</a>
            <a href="#categories">Categories</a>
            <a href="#newsletter">Newsletter</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <section id="featured">
            <h2>Featured Products</h2>
            <article>
                <h3>Wireless Headphones</h3>
                <p>High-quality wireless headphones for everyday use.</p>
            </article>
            <article>
                <h3>Smart Watch</h3>
                <p>A smart watch with fitness and notification features.</p>
            </article>
            <article>
                <h3>Laptop</h3>
                <p>Powerful laptop for work, study, and entertainment.</p>
            </article>
        </section>
        <section id="categories">
            <h2>Categories</h2>
            <ul>
                <li>Electronics</li>
                <li>Clothing</li>
                <li>Home Appliances</li>
                <li>Accessories</li>
            </ul>
        </section>
        <section id="newsletter">
            <h2>Newsletter Signup</h2>
            <form>
                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email">
                <button type="submit">Subscribe</button>
            </form>
        </section>
    </main>

    <footer id="contact">
        <div>
            <h3>Shop</h3>
            <a href="#">Products</a><br>
            <a href="#">Categories</a><br>
            <a href="#">Deals</a>
        </div>
        <div>
            <h3>Customer Service</h3>
            <a href="#">Help Center</a><br>
            <a href="#">Shipping</a><br>
            <a href="#">Returns</a>
        </div>
        <div>
            <h3>Company</h3>
            <a href="#">About Us</a><br>
            <a href="#">Contact Us</a><br>
            <a href="#">Privacy Policy</a>
        </div>
        <p>&copy; 2026 ShopEasy. All rights reserved.</p>
    </footer>
</body>
</html>
